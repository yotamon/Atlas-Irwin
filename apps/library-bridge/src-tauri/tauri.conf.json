{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ensemblis",
  "version": "0.2.0",
  "identifier": "com.ensemblis.library-bridge",
  "build": {
    "beforeDevCommand": "node build-platform-core.mjs",
    "beforeBuildCommand": "node build-platform-core.mjs",
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Ensemblis",
        "width": 920,
        "height": 720,
        "minWidth": 720,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'none'; img-src 'self' data:; style-src 'self'; script-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": false,
    "icon": [
      "../../../public/android-chrome-512x512.png"
    ]
  }
}
