NEXT_PUBLIC_SITE_URL=https://your-domain.com
CONTACT_SMTP_HOST=smtp.example.com
CONTACT_SMTP_PORT=465
CONTACT_SMTP_SECURE=true
CONTACT_SMTP_USER=you@example.com
CONTACT_SMTP_PASS=your-app-password
CONTACT_EMAIL_FROM=you@example.com
CONTACT_EMAIL_TO=you@example.com
MAILERLITE_API_KEY=your-mailerlite-api-token
MAILERLITE_GROUP_IDS=

# Ensemblis platform (use a Supabase publishable key in the anon variable)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-legacy-anon-key
# Server-only. Required by Video Director callbacks, durable media orchestration, marketing automation and explicit import/seed scripts.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-or-secret-key
STUDIO_ADMIN_EMAILS=you@example.com
STUDIO_PASSWORD=your-studio-password
# Optional explicit owner for import/seed; defaults to the first allowlisted email.
STUDIO_IMPORT_ADMIN_EMAIL=you@example.com
# Optional explicit owner UUID for the public artist catalog.
PUBLIC_CATALOG_OWNER_ID=
# On localhost, Studio routes bypass login automatically.
# Set this only if you want local writes without an auth session.
# Local demo seed remains off unless explicitly enabled.
ALLOW_STUDIO_DEMO_SEED=false

# Vercel AI Gateway - default text/reasoning backbone (server-only)
# Vercel deployments authenticate automatically with the injected VERCEL_OIDC_TOKEN.
# Do not create or persist VERCEL_OIDC_TOKEN yourself.
# Local development and non-Vercel runtimes should use a Vercel AI Gateway API key instead.
AI_GATEWAY_API_KEY=
# Same-model provider routing: cost | ttft | tps. Ensemblis defaults to cost when omitted/invalid.
ENSEMBLIS_AI_GATEWAY_PROVIDER_SORT=cost
# Optional standard request timeout in milliseconds (5000-300000). Default: 90000.
ENSEMBLIS_AI_GATEWAY_TIMEOUT_MS=90000
# Existing deployments may keep ATLAS_AI_GATEWAY_PROVIDER_SORT / ATLAS_AI_GATEWAY_TIMEOUT_MS;
# Ensemblis reads them only as legacy fallbacks when the canonical ENSEMBLIS_* values are absent.

# Direct specialist/creative provider credentials (all server-only)
# Kept for any explicit direct OpenAI route or rollback. Gateway-backed Marketing/Creative Director do not require it.
OPENAI_API_KEY=your-openai-api-key
# Google Gemini paid API. Used directly for Nano Banana and Veo creative routes.
GEMINI_API_KEY=your-gemini-api-key
# Black Forest Labs FLUX API.
BFL_API_KEY=your-bfl-api-key
# Z.AI GENERAL API key only. Used for direct Vidu creative routes. Never put a GLM Coding Plan key here.
ZAI_API_KEY=your-zai-general-api-key
# fal.ai queue API key. Ensemblis only uses explicitly configured marketplace endpoints and never guesses a paid endpoint.
FAL_KEY=your-fal-key
# Optional fal aliases used by the quality router. Keep empty until you select and verify exact marketplace models.
# Example shape:
# {"economy_video":{"endpoint":"vendor/model/image-to-video","price_per_second":0.05,"input_mode":"image_to_video"},"balanced_video":{"endpoint":"vendor/model/image-to-video","price_per_second":0.07,"input_mode":"image_to_video"}}
FAL_MODEL_CONFIG_JSON={}

# Ensemblis Marketing Intelligence - routed through Vercel AI Gateway
# Premium model override used by Ensemblis routing when premium escalation is required.
ENSEMBLIS_MARKETING_MODEL=openai/gpt-5.6-sol
# Optional comma-separated ordered model routes. Leave blank to use Ensemblis defaults.
# Defaults preserve the existing value-for-money policy:
# economy: zai/glm-4.7-flash
# balanced: openai/gpt-5.6-luna
# premium: openai/gpt-5.6-sol
ENSEMBLIS_MARKETING_ECONOMY_MODELS=
ENSEMBLIS_MARKETING_BALANCED_MODELS=
ENSEMBLIS_MARKETING_PREMIUM_MODELS=
# Multimodal QC model for generated social images/video. The default in code is a current vision-capable Gateway model.
ENSEMBLIS_CREATIVE_REVIEW_MODEL=openai/gpt-5.6-terra
# Optional ordered Gateway fallbacks; every configured fallback must support image input.
ENSEMBLIS_CREATIVE_REVIEW_FALLBACK_MODELS=
# Existing ATLAS_MARKETING_* and ATLAS_CREATIVE_REVIEW_* variables remain legacy fallbacks for production compatibility.
# Used by Vercel Cron as Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=replace-with-a-long-random-secret
# Optional independent salt for privacy-preserving attribution visitor hashes.
# If omitted, the server-side service key is used as the secret salt.
ATTRIBUTION_HASH_SALT=replace-with-another-long-random-secret

# Ensemblis Music Lab (server-only, direct specialist APIs)
# MiniMax Music is the low-cost default. music-2.6 is the currently documented direct API model.
MINIMAX_API_KEY=your-minimax-api-key
MINIMAX_MUSIC_MODEL=music-2.6
# Optional fallback used only when the preferred model is rejected as unsupported.
MINIMAX_MUSIC_FALLBACK_MODEL=
# Use music-2.6-free when your MiniMax account has free-trial model access.
# MINIMAX_MUSIC_MODEL=music-2.6-free
ELEVENLABS_API_KEY=your-elevenlabs-api-key
ELEVENLABS_MUSIC_MODEL=music_v2

# Ensemblis Video Director - Creative Director (routed through Vercel AI Gateway)
# Required. Use a Gateway model ID, for example openai/gpt-5.6-sol.
# Ensemblis intentionally has no guessed paid default so selecting a Director model is an explicit spend decision.
VIDEO_DIRECTOR_LLM_MODEL=
# Optional comma-separated model fallbacks handled by Vercel AI Gateway.
# Example: google/gemini-3.7-flash,zai/glm-4.7-flashx
VIDEO_DIRECTOR_LLM_FALLBACK_MODELS=

# Ensemblis Video Director - Higgsfield
# Preferred V2 credential format from the official Higgsfield SDK: KEY_ID:KEY_SECRET
HF_CREDENTIALS=
# A separate random secret Ensemblis includes in the Higgsfield webhook URL.
HIGGSFIELD_WEBHOOK_SECRET=
# JSON map of internal model IDs to VERIFIED Higgsfield public API endpoint paths.
# Ensemblis refuses to guess paid-generation endpoints. Example shape only:
# {"nano_banana_2":"/verified/image/path","seedance_2_0":"/verified/video/path"}
HIGGSFIELD_ENDPOINT_MAP_JSON={}
# Optional current credit rates. If omitted, Ensemblis uses conservative planning anchors and a larger reserve buffer.
# A number means credits per image or credits per video second. Resolution-specific objects are also accepted.
HIGGSFIELD_CREDIT_RATES_JSON={}
# Required before unlocking a non-zero global image/video USD hard cap for Video Director. Zero Cost works without it. Higgsfield credits remain the billing source of truth.
HIGGSFIELD_USD_PER_CREDIT=
# Keep false in production. Useful only for temporary API exploration when you explicitly accept endpoint inference risk.
HIGGSFIELD_ALLOW_INFERRED_ENDPOINTS=false
# Optional override. Defaults to https://platform.higgsfield.ai
HIGGSFIELD_BASE_URL=https://platform.higgsfield.ai

# Ensemblis Media Worker runs deployment-native on Vercel Sandbox.
# No separate worker endpoint, shared worker secret, container deployment, or cloud-provider configuration is required.

# SoundCloud Studio integration (server-only except redirect URL)
SOUNDCLOUD_CLIENT_ID=your-soundcloud-client-id
SOUNDCLOUD_CLIENT_SECRET=your-soundcloud-client-secret
# Optional; defaults to NEXT_PUBLIC_SITE_URL/studio/soundcloud/callback.
SOUNDCLOUD_REDIRECT_URI=https://your-domain.com/studio/soundcloud/callback

# Spotify Studio integration (all credentials are server-only)
SPOTIFY_CLIENT_ID=your-spotify-client-id
SPOTIFY_CLIENT_SECRET=your-spotify-client-secret
# Optional; defaults to NEXT_PUBLIC_SITE_URL/studio/spotify/callback.
# Local Spotify callbacks must use 127.0.0.1, not localhost.
SPOTIFY_REDIRECT_URI=https://your-domain.com/studio/spotify/callback
# Optional artist URL, URI, or ID. It can also be verified in Studio.
SPOTIFY_ARTIST_ID=

# Social channel OAuth for artist-aware campaign planning, publishing and audience automation.
# Ensemblis requests the provider scopes required by enabled automation features.
# TikTok Direct Post remains separately gated by the provider audit flag below.

# Instagram API with Instagram Login
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional; defaults to NEXT_PUBLIC_SITE_URL/studio/settings/social/instagram/callback
INSTAGRAM_REDIRECT_URI=
# Optional API version override. The integration defaults to its verified current version.
INSTAGRAM_GRAPH_API_VERSION=v25.0

# TikTok Login Kit / Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Optional; defaults to NEXT_PUBLIC_SITE_URL/studio/settings/social/tiktok/callback
TIKTOK_REDIRECT_URI=
# Keep false until the TikTok Content Posting API client has passed the Direct Post audit.
TIKTOK_DIRECT_POST_AUDITED=false
TIKTOK_DEFAULT_PRIVACY=PUBLIC_TO_EVERYONE
# Comma/semicolon-separated HTTPS prefixes that have been verified for PULL_FROM_URL photo publishing in the TikTok developer app.
# Example: https://media.your-domain.com/,https://your-project.supabase.co/storage/v1/object/public/social/
TIKTOK_PHOTO_URL_PREFIXES=

# YouTube Data API OAuth 2.0 web client
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
# Optional; defaults to NEXT_PUBLIC_SITE_URL/studio/settings/social/youtube/callback
YOUTUBE_REDIRECT_URI=
YOUTUBE_DEFAULT_PRIVACY=public
YOUTUBE_CATEGORY_ID=10